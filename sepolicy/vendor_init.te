allow vendor_init wifi_data_file:dir { search setattr getattr };
allow vendor_init proc:file write;

# vendor.rild.libpath and libargs from the vendor build.prop, which init only
# loads when vendor_init may set them: without it rild never loads qcril
set_prop(vendor_init, vendor_rild_libpath_prop)

# restorecon of /persist/.bt_nv.bin, from the labels older builds left
allow vendor_init { persist_file bluetooth_data_file }:file { getattr relabelfrom };
allow vendor_init persist_bluetooth_file:file relabelto;
