allow mm-qcamerad system_data_file:dir { add_name remove_name write };
allow mm-qcamerad vendor_file:file execmod;

allow mm-qcamerad { cameraserver hal_camera_default }:fd use;
allow mm-qcamerad video_device:chr_file rw_file_perms;
allow mm-qcamerad video_device:dir r_dir_perms;

set_prop(mm-qcamerad, vendor_camera_sensor_prop)
get_prop(mm-qcamerad, vendor_camera_hal_prop)
